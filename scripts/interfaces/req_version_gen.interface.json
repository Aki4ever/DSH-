{
  "id": "cli.rules.req_version_gen",
  "layer": "脚本 (CLI)",
  "path": "scripts/req_version_gen.mjs",
  "invoke": "node scripts/req_version_gen.mjs",
  "summary": "需求版本机读台账生成器：从主台账抽出编号/需求版本/实施版本/承载文件（REQ-092 / R2-c）",
  "inputs": [
    { "name": "--check", "type": "arg", "required": false, "desc": "只判不写；与磁盘产物不一致退出码 1" },
    { "name": "--json", "type": "arg", "required": false, "desc": "打印机读台账" }
  ],
  "outputs": [
    { "name": "ai-control/requirements/req_versions.json", "type": "file", "desc": "机读需求版本台账（92 条）" },
    { "name": "stdout", "type": "text", "desc": "条目数/声明值/推导值/悬空引用统计" }
  ],
  "exitCodes": { "0": "已写入或一致", "1": "--check 下产物缺失或不一致", "2": "未知参数" },
  "sideEffects": ["写 ai-control/requirements/req_versions.json"],
  "dependencies": ["docs/requirements.md"],
  "parallel": "exclusive",
  "examples": ["node scripts/req_version_gen.mjs", "node scripts/req_version_gen.mjs --check"],
  "source": "handwritten",
  "verified": true
}
